        },
        "net_new_discretionary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "UNKNOWN",
          "title": "Net New Discretionary"
        },
        "overall_ratio": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "UNKNOWN",
          "title": "Overall Ratio"
        }
      },
      "title": "Rule2Accounting",
      "type": "object"
    },
    "SourceSpecFingerprint": {
      "additionalProperties": false,
      "properties": {
        "filename": {
          "title": "Filename",
