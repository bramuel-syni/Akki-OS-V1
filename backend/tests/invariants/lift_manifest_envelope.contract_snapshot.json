        "cousin_citation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cousin Citation"
        },
        "lift_kind": {
          "title": "Lift Kind",
          "type": "string"
        },
        "module": {
          "title": "Module",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "resolves_by": {
          "items": {
            "type": "string"
          },
          "title": "Resolves By",
          "type": "array"
        },
        "shape_signature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shape Signature"
        },
        "transitive_chain": {
