{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "lift_manifest@v0",
  "description": "Schema of /app/docs/lift_manifest.json — the machine-readable transitive-lift discipline enforcement surface. Frozen per BUILD_JOURNAL discipline-moment #7.",
  "type": "object",
  "required": ["manifest_version", "generated_at", "substrate_state", "entries"],
  "properties": {
    "manifest_version": {"type": "string", "const": "v0"},
    "generated_at": {"type": "string"},
    "generated_by": {"type": "string"},
    "discipline_ref": {"type": "string"},
    "substrate_state": {
      "type": "object",
      "required": ["reference_akki_legacy_present"],
      "properties": {
        "reference_akki_legacy_present": {"type": "boolean"},
        "note": {"type": "string"}
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module", "shape_signature", "lift_kind", "resolves_by", "notes"],
        "properties": {
          "module": {"type": "string"},
          "cousin_citation": {"type": ["string", "null"]},
          "shape_signature": {"type": "string"},
          "resolves_by": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "lift_kind": {
            "type": "string",
            "enum": [
              "direct",
              "transitive",
              "unverifiable-substrate-absent",
              "mandate-forced-net-new"
            ]
          },
          "transitive_chain": {
            "type": "array",
            "items": {"type": "string"}
          },
          "notes": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
